{
  "expo": {
    "name": "Linterna",
    "slug": "luz-viajera-app",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "assetBundlePatterns": ["**/*"],
    "android": {
      "package": "com.yer6isla.linterna",
      "permissions": ["CAMERA", "VIBRATE", "WAKE_LOCK"],
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#0b0f14"
      }
    },
    "plugins": [
      ["expo-camera", { "cameraPermission": "Se usa la cámara solo para encender la linterna." }]
    ]
  }
}
